{
  "_meta": {
    "title": "GridWise error-path cases (400 / 422 / 500)",
    "endpoint": "POST /optimize-energy",
    "notes": [
      "400 = malformed JSON / unreadable body",
      "422 = well-formed JSON that fails schema or semantic validation",
      "500 = controlled provider/internal failure (no secrets or stack traces)",
      "500 cases require a reachable server whose OPENAI_API_KEY is missing or invalid."
    ]
  },
